# Streamlit Community Cloud Secrets Template
# ==========================================
# Copy this content to your Streamlit Cloud app's secrets settings:
# https://share.streamlit.io/ → Your App → Settings → Secrets
#
# Or for local development, copy to: .streamlit/secrets.toml

# Neo4j Connection (Railway)
# Replace YOUR_RAILWAY_URL with your actual Railway public URL
# Example: dynastyedge-production.up.railway.app
neo4j_uri = "bolt://YOUR_RAILWAY_URL:7687"
neo4j_user = "neo4j"
neo4j_password = "dynastyedge2025"

# Alternative: Neo4j Aura (if using Aura instead)
# neo4j_uri = "neo4j+s://YOUR_AURA_INSTANCE.databases.neo4j.io"
# neo4j_user = "neo4j"
# neo4j_password = "YOUR_AURA_PASSWORD"

# Anthropic API Key (for AI chat features)
ANTHROPIC_API_KEY = "YOUR_ANTHROPIC_API_KEY"

# Sleeper League ID (for fantasy league sync)
SLEEPER_LEAGUE_ID = "YOUR_SLEEPER_LEAGUE_ID"
