<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thoth.ktc-snapshot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
        <string>/Users/kurultai/ktcvaluehog/scripts/ktc_snapshot_job.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/kurultai/ktcvaluehog</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/Library/Frameworks/Python.framework/Versions/3.13/bin</string>
    </dict>

    <!-- Run at 6:00 AM and 6:00 PM daily -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>18</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <!-- Log output -->
    <key>StandardOutPath</key>
    <string>/Users/kurultai/ktcvaluehog/logs/ktc_snapshot_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/kurultai/ktcvaluehog/logs/ktc_snapshot_stderr.log</string>

    <!-- Run missed jobs on wake from sleep -->
    <key>StartInterval</key>
    <integer>43200</integer>

    <!-- Keep alive settings -->
    <key>KeepAlive</key>
    <false/>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
